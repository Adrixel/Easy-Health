@baseUrl = http://localhost:3333

# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "roberto.dono@email.com",
  "senha": "senha123"
}

###

# @name primeiroCadastro
POST {{baseUrl}}/api/estabelecimentos?accessToken={{login.response.body.$.accessToken}}
Content-Type: application/json

