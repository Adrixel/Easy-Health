# Copie este arquivo para ".env" na raiz do projeto antes de rodar
# `docker compose up`. O Compose lê automaticamente um arquivo ".env"
# na mesma pasta do docker-compose.yml para interpolar estas variáveis.

# --- Banco de dados (MySQL) ---
MYSQL_USER=easyhealth
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=easyhealth
MYSQL_PORT=3306

# --- Backend ---
BACKEND_PORT=3333
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
RESET_CODE_LOG_ENABLED=false
CORS_ORIGIN=*
# IDs OAuth públicos do Google (não colocar client secrets aqui).
GOOGLE_OAUTH_CLIENT_IDS=easy-health-515022 

# --- Frontend web (Expo) ---
FRONTEND_PORT=8081
# Opcional: sobrescreva a URL da API. COLOQUE SUA IP LOCAL NO EXPO_PUBLIC_API_URL=COLOQUE_AQUI:3333
EXPO_PUBLIC_API_URL=http://192.168.3.52:3333
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=876030823316-kvn4c82p7io9askckiril8ccj5301oaa.apps.googleusercontent.com 
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=876030823316-96hmph5s0tsm2pvs2qucrb2v5f88duj9.apps.googleusercontent.com

# --- Adminer (UI web para inspecionar o banco, opcional) ---
ADMINER_PORT=8080
